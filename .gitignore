# Python
__pycache__/
*.pyc

# Models: downloaded automatically on first run
*.pt
*.task
# TensorRT engine only works on the GPU it was built on (python export_engine.py)
*.engine
*.onnx

# Ultralytics run outputs
runs/

# Player settings from the Options screen (each computer keeps its own)
settings.json

# Python environment created by setup.ps1 / setup.sh
.venv/

# Working files of the documentation builder (tools/docs)
docs/_build/

# Score board of finished runs (each computer keeps its own)
scores.json
scores.json.*
